# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Secrets are better passed as environment variables than written to disk:
#   export TF_VAR_hcloud_token=...
#   export TF_VAR_tailscale_auth_key=...

cluster_name = "k3s"

# Your Tailnet's MagicDNS domain — Tailscale admin console > DNS.
tailscale_magicdns_domain = "tailXXXX.ts.net"

# Override only if your keys live elsewhere.
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_private_key_path = "~/.ssh/id_ed25519"

# Prefer the env vars above instead of uncommenting these.
# hcloud_token       = ""
# tailscale_auth_key = ""
