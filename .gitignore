# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# 1Password CLI env file: maps TF_VAR_* to secret references. Gitignored because
# the item/vault names reveal the secret inventory.
.env.tofu

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Plan artifacts: may contain sensitive values in cleartext
*.tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Cluster kubeconfig written by kube-hetzner (create_kubeconfig defaults to true)
*_kubeconfig.yaml

# Kustomization backup written by kube-hetzner (create_kustomization defaults to true);
# sensitive, regenerated on every apply
*_kustomization_backup.yaml

# Vendored agent skill packages: restorable via `npx skills add` from
# skills-lock.json, which is tracked. Not project code, no need to commit.
.agents/
.claude/skills/

# 1Password
.op
